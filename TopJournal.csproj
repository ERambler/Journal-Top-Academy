<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>ru.erambler.topjournal</ApplicationId>
    <ApplicationVersion>8</ApplicationVersion>
    <ApplicationDisplayVersion>0.3</ApplicationDisplayVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetSdkVersion>35</TargetSdkVersion>
    <AndroidUseLatestPlatformSdk>false</AndroidUseLatestPlatformSdk>
    <!-- APK сразу, без AAB -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Минимальный размер APK:
         только arm64 (x86_64 выбрасывается), Mono-интерпретатор вместо AOT-образов
         (все libaot-*.so уходят), обрезка BCL триммером, инвариантная глобализация
         без ICU. JSON — Source Generator (AppJson), иначе триммер вырежет рефлексию. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Полный самодостаточный APK даже в Debug: без Fast Deployment
         (иначе сборки .NET кладутся только через adb install из IDE,
         и APK, поставленный файлом, падает при старте) -->
    <AndroidFastDeployment>false</AndroidFastDeployment>
  </PropertyGroup>

</Project>
