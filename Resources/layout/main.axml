<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <!-- Шапка: студент + (в альбомной ориентации вкладки) + обновить -->
  <LinearLayout
      android:orientation="horizontal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:paddingHorizontal="16dp"
      android:paddingTop="12dp"
      android:paddingBottom="8dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

      <TextView
          android:id="@+id/studentName"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="…"
          android:textSize="17sp"
          android:textStyle="bold"
          android:textColor="@color/ink"
          android:maxLines="1"
          android:ellipsize="end" />

      <TextView
          android:id="@+id/studentGroup"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text=""
          android:textSize="12sp"
          android:textColor="@color/inkSecondary"
          android:maxLines="1"
          android:ellipsize="end" />
    </LinearLayout>

    <!-- в горизонтальной ориентации вкладки переезжают сюда -->
    <LinearLayout
        android:id="@+id/tabsInHeader"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <Button
        android:id="@+id/refreshBtn"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⟳ Обновить"
        android:textColor="@color/accent"
        android:textSize="13sp" />
  </LinearLayout>

  <!-- Вкладки (портретная ориентация) -->
  <LinearLayout
      android:id="@+id/tabBar"
      android:orientation="horizontal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/tabBarBg">

    <TextView
        android:id="@+id/tabGrades"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="Оценки"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tabSchedule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="Расписание"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tabHomework"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="ДЗ"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tabAnalytics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="Аналитика"
        android:textSize="13sp"
        android:textStyle="bold" />
  </LinearLayout>

  <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@color/gridLine" />

  <!-- Контент -->
  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <TextView
        android:id="@+id/emptyHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Нет данных.\nНажмите «Обновить» или подождите синхронизации"
        android:gravity="center"
        android:textColor="@color/inkSecondary"
        android:textSize="14sp" />

    <!-- Оценки: закреплённая колонка предметов + сетка дат с синхронным заголовком -->
    <LinearLayout
        android:id="@+id/gradesRoot"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

      <LinearLayout
          android:orientation="horizontal"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

        <TextView
            android:id="@+id/gradesCorner"
            android:layout_width="108dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="Предмет"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/inkSecondary"
            android:background="@color/gridHeaderBg" />

        <HorizontalScrollView
            android:id="@+id/gradesHeaderScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

          <LinearLayout
              android:id="@+id/gradesHeaderRow"
              android:orientation="horizontal"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
        </HorizontalScrollView>
      </LinearLayout>

      <ScrollView
          android:id="@+id/gradesBody"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:scrollbars="none">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

          <LinearLayout
              android:orientation="horizontal"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content">

            <TableLayout
                android:id="@+id/subjectsTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <HorizontalScrollView
                android:id="@+id/gradesGridScroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

              <TableLayout
                  android:id="@+id/gradesTable"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content" />
            </HorizontalScrollView>
          </LinearLayout>

          <!-- Итоги прогулов/опозданий под таблицей -->
          <LinearLayout
              android:id="@+id/gradesSummary"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:padding="12dp" />
        </LinearLayout>
      </ScrollView>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scheduleScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scrollbars="none">

      <LinearLayout
          android:id="@+id/scheduleList"
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="12dp" />
    </ScrollView>

    <ScrollView
        android:id="@+id/hwScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scrollbars="none">

      <LinearLayout
          android:id="@+id/hwList"
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="12dp" />
    </ScrollView>

    <ScrollView
        android:id="@+id/analyticsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scrollbars="none">

      <LinearLayout
          android:id="@+id/analyticsList"
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="12dp" />
    </ScrollView>
  </FrameLayout>
</LinearLayout>
