<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

  <LinearLayout
      android:orientation="horizontal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical">

    <TextView
        android:id="@+id/wName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Журнал ТОП"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/wTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8E9AB8"
        android:textSize="10sp" />
  </LinearLayout>

  <LinearLayout
      android:orientation="horizontal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center_vertical">

    <TextView
        android:id="@+id/wAvg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#FFD166"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">

      <TextView
          android:id="@+id/wAttend"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="посещаемость —"
          android:textColor="#C7CFE4"
          android:textSize="11sp" />

      <TextView
          android:id="@+id/wHw"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:text="ДЗ —"
          android:textColor="#C7CFE4"
          android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>

  <TextView
      android:id="@+id/wSchedTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="📅 Расписание"
      android:textColor="#8E9AB8"
      android:textSize="10sp"
      android:textStyle="bold" />

  <TextView
      android:id="@+id/wSched1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text=""
      android:textColor="#C7CFE4"
      android:textSize="10sp"
      android:maxLines="1"
      android:ellipsize="end" />

  <TextView
      android:id="@+id/wSched2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text=""
      android:textColor="#C7CFE4"
      android:textSize="10sp"
      android:maxLines="1"
      android:ellipsize="end" />

  <TextView
      android:id="@+id/wHwTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="📌 ДЗ к сдаче"
      android:textColor="#8E9AB8"
      android:textSize="10sp"
      android:textStyle="bold" />

  <TextView
      android:id="@+id/wHw1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text=""
      android:textColor="#C7CFE4"
      android:textSize="10sp"
      android:maxLines="2"
      android:ellipsize="end" />

  <TextView
      android:id="@+id/wHw2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text=""
      android:textColor="#C7CFE4"
      android:textSize="10sp"
      android:maxLines="2"
      android:ellipsize="end" />
</LinearLayout>
